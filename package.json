{
  "name": "crypto-api-ng",
  "version": "0.0.0",
  "description": "Maintained Zig/WebAssembly port of crypto-api",
  "private": true,
  "type": "module",
  "main": "js/index.js",
  "types": "js/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "zig build wasm --release=small",
    "build:debug": "zig build wasm",
    "test": "zig build check",
    "test:zig": "zig build test",
    "test:js": "zig build test-js",
    "vendor": "node scripts/vendor-legacy.mjs",
    "vectors": "node scripts/extract-vectors.mjs",
    "test:compat": "node --test \"test/compat/*.test.js\"",
    "test:legacy-suite": "node test/legacy-suite/run.mjs target",
    "test:legacy-suite:oracle": "node test/legacy-suite/run.mjs oracle",
    "test:parity": "npm run test:legacy-suite && npm run test:compat",
    "build:package": "node scripts/build-package.mjs",
    "pack": "node scripts/build-package.mjs --pack",
    "test:package": "node --test \"test/package/*.test.js\"",
    "test:runtimes": "node scripts/test-runtimes.mjs"
  },
  "devDependencies": {
    "@babel/core": "8.1.2",
    "@babel/preset-env": "8.0.7",
    "acorn": "8.19.0",
    "esbuild": "0.28.2",
    "terser": "5.51.2",
    "typescript": "5.9.3"
  }
}
