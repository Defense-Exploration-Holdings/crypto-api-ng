{
  "name": "crypto-api-ng",
  "version": "1.1.0",
  "description": "Hashing library with no dependencies: maintained Zig/WebAssembly port of crypto-api",
  "private": true,
  "license": "MIT",
  "author": "Aleksandr Mogilnikov <nf404.name@gmail.com> (https://nf404.name/)",
  "homepage": "https://github.com/Defense-Exploration-Holdings/crypto-api-ng",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Defense-Exploration-Holdings/crypto-api-ng.git",
    "directory": "packages/crypto-api"
  },
  "bugs": {
    "url": "https://github.com/Defense-Exploration-Holdings/crypto-api-ng/issues"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "module": "src/index.mjs",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "node": "./index.js",
      "import": "./src/index.mjs",
      "default": "./index.js"
    },
    "./blake2b": {"types": "./src/hasher/blake2b.d.mts", "default": "./src/hasher/blake2b.mjs"},
    "./blake2s": {"types": "./src/hasher/blake2s.d.mts", "default": "./src/hasher/blake2s.mjs"},
    "./blake3": {"types": "./src/hasher/blake3.d.mts", "default": "./src/hasher/blake3.mjs"},
    "./has160": {"types": "./src/hasher/has160.d.mts", "default": "./src/hasher/has160.mjs"},
    "./keccak": {"types": "./src/hasher/keccak.d.mts", "default": "./src/hasher/keccak.mjs"},
    "./md2": {"types": "./src/hasher/md2.d.mts", "default": "./src/hasher/md2.mjs"},
    "./md4": {"types": "./src/hasher/md4.d.mts", "default": "./src/hasher/md4.mjs"},
    "./md5": {"types": "./src/hasher/md5.d.mts", "default": "./src/hasher/md5.mjs"},
    "./ripemd": {"types": "./src/hasher/ripemd.d.mts", "default": "./src/hasher/ripemd.mjs"},
    "./sha0": {"types": "./src/hasher/sha0.d.mts", "default": "./src/hasher/sha0.mjs"},
    "./sha1": {"types": "./src/hasher/sha1.d.mts", "default": "./src/hasher/sha1.mjs"},
    "./sha256": {"types": "./src/hasher/sha256.d.mts", "default": "./src/hasher/sha256.mjs"},
    "./sha3": {"types": "./src/hasher/sha3.d.mts", "default": "./src/hasher/sha3.mjs"},
    "./sha512": {"types": "./src/hasher/sha512.d.mts", "default": "./src/hasher/sha512.mjs"},
    "./shake": {"types": "./src/hasher/shake.d.mts", "default": "./src/hasher/shake.mjs"},
    "./sm3": {"types": "./src/hasher/sm3.d.mts", "default": "./src/hasher/sm3.mjs"},
    "./snefru": {"types": "./src/hasher/snefru.d.mts", "default": "./src/hasher/snefru.mjs"},
    "./whirlpool": {"types": "./src/hasher/whirlpool.d.mts", "default": "./src/hasher/whirlpool.mjs"},
    "./hmac": {"types": "./src/mac/hmac.d.mts", "default": "./src/mac/hmac.mjs"},
    "./encoder/hex": {"types": "./src/encoder/hex.d.mts", "default": "./src/encoder/hex.mjs"},
    "./encoder/base64": {"types": "./src/encoder/base64.d.mts", "default": "./src/encoder/base64.mjs"},
    "./encoder/utf": {"types": "./src/encoder/utf.d.mts", "default": "./src/encoder/utf.mjs"},
    "./encoder/array-buffer": {"types": "./src/encoder/array-buffer.d.mts", "default": "./src/encoder/array-buffer.mjs"},
    "./src/*.mjs": "./src/*.mjs",
    "./src/*.d.mts": "./src/*.d.mts",
    "./src/*": "./src/*.mjs",
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "typesVersions": {
    "*": {
      "blake2b": ["src/hasher/blake2b.d.mts"],
      "blake2s": ["src/hasher/blake2s.d.mts"],
      "blake3": ["src/hasher/blake3.d.mts"],
      "has160": ["src/hasher/has160.d.mts"],
      "keccak": ["src/hasher/keccak.d.mts"],
      "md2": ["src/hasher/md2.d.mts"],
      "md4": ["src/hasher/md4.d.mts"],
      "md5": ["src/hasher/md5.d.mts"],
      "ripemd": ["src/hasher/ripemd.d.mts"],
      "sha0": ["src/hasher/sha0.d.mts"],
      "sha1": ["src/hasher/sha1.d.mts"],
      "sha256": ["src/hasher/sha256.d.mts"],
      "sha3": ["src/hasher/sha3.d.mts"],
      "sha512": ["src/hasher/sha512.d.mts"],
      "shake": ["src/hasher/shake.d.mts"],
      "sm3": ["src/hasher/sm3.d.mts"],
      "snefru": ["src/hasher/snefru.d.mts"],
      "whirlpool": ["src/hasher/whirlpool.d.mts"],
      "hmac": ["src/mac/hmac.d.mts"],
      "encoder/hex": ["src/encoder/hex.d.mts"],
      "encoder/base64": ["src/encoder/base64.d.mts"],
      "encoder/utf": ["src/encoder/utf.d.mts"],
      "encoder/array-buffer": ["src/encoder/array-buffer.d.mts"]
    }
  },
  "unpkg": "crypto-api.min.js",
  "jsdelivr": "crypto-api.min.js",
  "files": [
    "example",
    "legacy",
    "src",
    "wasm",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "crypto-api.js",
    "crypto-api.min.js",
    "crypto-api.min.js.map",
    "index.js",
    "index.d.ts",
    "types.d.ts"
  ],
  "sideEffects": false,
  "dependencies": {},
  "keywords": [
    "hash", "hashes", "md2", "md4", "md5", "ripemd128", "ripemd160", "ripemd256", "ripemd320",
    "blake2", "blake2b", "blake2s", "blake3",
    "has160", "has-160", "sha0", "sha1", "sha224", "sha256", "sha384", "sha512", "sha512/t",
    "sha512/224", "sha512/256", "sha3", "sha3-256", "shake128", "shake256", "keccak", "keccak256", "whirlpool", "whirlpool-0", "whirlpool-t", "sm3", "snefru",
    "hmac", "wasm", "webassembly", "zig"
  ]
}
